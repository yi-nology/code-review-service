# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
# 根锚定：只忽略仓库根下编译出来的可执行文件。
# 不加前导 "/" 时，模式会匹配任意层级的同名路径——曾把源码目录
# cmd/mcp-server/ 整个误判为构建产物（其 main.go 处于「已跟踪却被忽略」状态）。
/review-service
/code-review-service
/mcp-server
# Platform-specific Go build artifacts
*-linux-amd64
*-linux-arm64
*-darwin-amd64
*-darwin-arm64
*-windows-amd64.exe
# Compiled binary directories
bin/
cmd/*/bin/

# Go
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/

# Test artifacts
*.test
*.out
coverage.html
# Loose PNG/JPG at repo root (use frontend/tests/fixtures/ or testdata/ for legitimate fixtures)
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# Data (local development)
data/*.json
!data/.gitkeep

# Environment
.env
.env.local
.playwright-mcp

