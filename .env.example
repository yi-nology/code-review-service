# Review Service Configuration
# Copy this file to .env and fill in your values.

# Authentication token for API access (required)
REVIEW_TOKEN=dev-token

# Database connection (required)
DATABASE_URL=postgres://review_service:review_service@localhost:5432/review_service?sslmode=disable
DATABASE_MAX_OPEN=50
DATABASE_MAX_IDLE=10
# Set to false to disable auto-migration in production (default: true)
# DATABASE_AUTO_MIGRATE=true

# Git platform tokens (at least one recommended)
GITHUB_TOKEN=
GITLAB_TOKEN=
GITEA_TOKEN=
GITEA_BASE_URL=

# Worker configuration
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=1s
WORKER_STALE_AFTER=15m

# OCR (Alibaba Open Code Review)
OCR_ENABLED=false
OCR_BINARY=ocr
OCR_RULE=

# Policy
POLICY_FAIL_ON=critical
POLICY_MAX_COMMENTS=20
POLICY_SUMMARY_ONLY=false
POLICY_IGNORE_PATHS=vendor/**,dist/**,*.pb.go

# Observability (optional)
NACOS_ADDR=
NACOS_NAMESPACE=
OTEL_ENDPOINT=
