# 增量部署镜像（FROM alpine + COPY 现成二进制，适合已有构建产物的增量发布）。
# 同步约束：OCR_VERSION 与 MCP npm 包清单须与另两个 Dockerfile 保持一致。
FROM alpine:3.21

RUN apk add --no-cache ca-certificates git wget curl \
    && adduser -D review

# Node.js（MCP server 运行时）
RUN apk add --no-cache nodejs npm

# OCR binary
ARG OCR_VERSION=v1.13.2
RUN wget -qO /usr/local/bin/ocr \
    "https://github.com/alibaba/open-code-review/releases/download/${OCR_VERSION}/opencodereview-linux-amd64" \
    && chmod +x /usr/local/bin/ocr

# 预装 MCP server 包
RUN npm install -g \
    zfetch-mcp \
    @upstash/context7-mcp \
    @modelcontextprotocol/server-sequential-thinking \
    @modelcontextprotocol/server-memory \
    @modelcontextprotocol/server-time \
    2>/dev/null || true

WORKDIR /app
USER review
COPY review-service /usr/local/bin/review-service
COPY mcp-server /usr/local/bin/mcp-server

EXPOSE 8080 8082
ENTRYPOINT ["review-service"]
